# Native-run config for web (compose users: use the root .env instead).
# NEXT_PUBLIC_* are inlined at build time.
NEXT_PUBLIC_ENVOY_URL=http://localhost:8082
# Google OAuth web client id (= api/common GOOGLE_CLIENT_ID). Register
# <origin>/signin/callback as an authorized redirect URI.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_TEST_MODE=1 runs against the in-app mock with no backend/Google.
