# Native-run config for web (compose users: use the root .env instead).
# NEXT_PUBLIC_* are inlined at build time.
NEXT_PUBLIC_ENVOY_URL=http://localhost:2002
# Google OAuth web client id (= api/common GOOGLE_CLIENT_ID). The root .env
# is also read, so setting it there is enough. Redirect URIs to register:
# <web origin>/signin/callback and http://localhost:2004/callback (desktop).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=76675439237-2e70vh6psr95ro0krgutue2skkthjk32.apps.googleusercontent.com
GOOGLE_CLIENT_ID=76675439237-2e70vh6psr95ro0krgutue2skkthjk32.apps.googleusercontent.com
# NEXT_PUBLIC_TEST_MODE=1 runs against an in-browser fake backend (no backend/Google needed).
