{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Upstat",
  "version": "0.1.0",
  "identifier": "io.cuesoft.upstat",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:2005",
    "beforeDevCommand": "DESKTOP=1 NEXT_PUBLIC_DESKTOP=1 next dev -p 2005",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Upstat",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:2002"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Uptime monitoring, incidents and status pages",
    "copyright": "\u00a9 Cuesoft Inc. MIT License."
  }
}
