# Copy to .env for local development: cp .env.example .env
# MONGO_URI is set to the in-cluster mongo service in docker-compose.yml.

# --- api-common (Go) ---
JWT_SECRET=dev-secret-change-me
GOOGLE_CLIENT_ID=
BASE_URL=http://localhost:2000/

# Downtime / recovery emails via EmailJS (https://dashboard.emailjs.com).
# Leave blank to log notifications instead of emailing them. Also enable
# Account → Security → "Allow EmailJS API for non-browser applications".
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Web UI origin, used for the "View incident" link in emails.
APP_URL=http://localhost:2003

# --- api-observability (Python / ML insights) ---
MONGO_DB=Upstat
GROQ_API_KEY=
# Service-to-service gRPC auth token (generate via api/common/cmd/make_service_token).
# Leave blank to boot the stack; required for live cross-service gRPC calls.
UPSTAT_GRPC_AUTH_TOKEN=
UPSTAT_GRPC_CHECK_LIMIT=100

# --- web (build-time, inlined into the image) ---
# gRPC-Web endpoint (Envoy) as seen from the browser.
NEXT_PUBLIC_ENVOY_URL=http://localhost:2002
# Google OAuth "Web application" client id — same value as GOOGLE_CLIENT_ID.
# Authorized redirect URIs on that client:
#   http://localhost:2003/signin/callback   (web app)
#   http://localhost:2004/callback          (desktop app — loopback sign-in)
# Authorized JavaScript origin: http://localhost:2003
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
